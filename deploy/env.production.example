# Plantilla del .env de producción. Copiar a /var/www/reypass/.env (chmod 600).
APP_NAME="Super El Rey"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://TU_DOMINIO
# Se generan UNA sola vez (guía, paso 4) y se guardan en el gestor de contraseñas.
# Si se pierden o se cambian, los datos y las fotos quedan ilegibles.
APP_KEY=
DNI_HASH_KEY=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- Correo (opción A, recomendada): Resend por HTTPS ---
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-responder@TU_DOMINIO
MAIL_FROM_NAME="Super El Rey"

# --- Correo (opción B): Brevo por SMTP en el puerto 2525 ---
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-responder@TU_DOMINIO
# MAIL_FROM_NAME="Super El Rey"

VITE_APP_NAME="${APP_NAME}"
